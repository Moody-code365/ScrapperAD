# ScrapperAD — пример конфигурации.
# Скопируй в .env и заполни:  cp .env.example .env

# Токен Telegram-бота от @BotFather (обязательно)
BOT_TOKEN=your_telegram_bot_token_here

# Apify API — слежка за рекламой (https://console.apify.com/account/integrations)
# Можно указать СРАЗУ НЕСКОЛЬКО ключей через запятую — бот сам переключится на
# следующий, когда у текущего кончится бесплатный месячный лимит ($5/мес на free-аккаунте):
#   APIFY_API_TOKENS=apify_api_xxx1,apify_api_xxx2,apify_api_xxx3
APIFY_API_TOKENS=
# (Один ключ можно задать и по-старому — используется, если APIFY_API_TOKENS пуст)
APIFY_API_TOKEN=

# Gemini API — AI-разбор конкурентов (бесплатный тир достаточно)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Твой Telegram username без @ — кнопка «Написать в поддержку» откроет диалог с тобой
SUPPORT_USERNAME=your_telegram_username

# Путь к базе (по умолчанию data/scrapperad.db)
DATABASE_PATH=data/scrapperad.db

# Твой Telegram ID (для админ-функций: /grant, /users, /stats, /admin)
# Узнать свой ID: написать @userinfobot в Telegram
ADMIN_TELEGRAM_ID=0

# Режим отладки (True/False). Выключи на проде.
DEBUG=False

# Реквизиты для оплаты картой — в коде НЕ хранятся, передаются в личке.
# Если хочешь показывать номер прямо в боте (не рекомендуется) — раскомментируй:
# KASPI_NUMBER=
# KASPI_NAME=

# Anthropic API — зарезервировано для будущих фич, сейчас не нужен
# ANTHROPIC_API_KEY=
